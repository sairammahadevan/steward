# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-key-here

# Models (optional — these are the defaults)
EXTRACTION_MODEL=claude-haiku-4-5-20251001
QUERY_MODEL=claude-sonnet-4-6

# Paths (optional — defaults shown)
DOCS_DIR=docs
DB_PATH=steward.db

# Logging
LOG_LEVEL=INFO

# ── Email ingestion (optional) ───────────────────────────────────────────────
# Forward or send PDFs/DOCX to this address and STEWARD will auto-ingest them.
#
# Gmail setup:
#   1. Go to myaccount.google.com/apppasswords
#   2. Create an App Password for "Mail"
#   3. Paste the 16-character password below (no spaces)
#
STEWARD_EMAIL=you@gmail.com
STEWARD_EMAIL_PASSWORD=xxxxxxxxxxxxxxxxxxxx
EMAIL_POLL_MINUTES=5
# EMAIL_IMAP_HOST=imap.gmail.com   # default — change for Outlook/other providers
# EMAIL_IMAP_PORT=993
